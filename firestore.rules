rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Комната открыта только авторизованным (анонимный вход в приложении).
    // Код комнаты работает как общий секрет двух устройств.
    match /rooms/{roomId} {
      allow read, write: if request.auth != null;
      match /{document=**} {
        allow read, write: if request.auth != null;
      }
    }
  }
}
